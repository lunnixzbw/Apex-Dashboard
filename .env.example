# ── Apex bot API (server-side only: none of these are exposed to the browser) ──
# Same machine as the bot:   http://127.0.0.1:8000/api/v1
# Dashboard on Vercel/other host: put the bot API behind HTTPS (Cloudflare Tunnel etc.) and use that URL.
BOT_API_URL=http://127.0.0.1:8000/api/v1
# Must exactly match DASHBOARD_API_KEY in the bot's environment. Generate: openssl rand -hex 32
DASHBOARD_API_KEY=

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Discord OAuth (Developer Portal → OAuth2; add redirect: <NEXTAUTH_URL>/api/auth/callback/discord) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Branding ──
# Only controls which admin links are SHOWN. Real admin access = OWNER_IDS in the bot's config.js.
NEXT_PUBLIC_ADMIN_IDS=
NEXT_PUBLIC_BRAND_NAME="Apex"
NEXT_PUBLIC_BRAND_NAME_WORD="AX"
