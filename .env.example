# ── Zevion bot API (server-side only: none of these are exposed to the browser) ──
BOT_API_URL=https://api.apex-bot.bond/api/v1
# Must exactly match DASHBOARD_API_KEY in the bot (dashboard/index.js). Generate: openssl rand -hex 32
DASHBOARD_API_KEY=

# ── NextAuth ──
NEXTAUTH_URL=https://zevion.bond
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Discord OAuth (Developer Portal → OAuth2; redirect: https://zevion.bond/api/auth/callback/discord) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Branding (these two must be "Config", not "Secret", on Vercel) ──
# Your Discord user ID(s), comma separated, no spaces. This ALONE gives access to the admin panel.
NEXT_PUBLIC_ADMIN_IDS=
NEXT_PUBLIC_BRAND_NAME=Zevion
NEXT_PUBLIC_BRAND_NAME_WORD=ZV
NEXT_PUBLIC_SITE_URL=https://zevion.bond

# ── Subdomains (optional) ──
# Docs on their own domain. Leave empty to serve docs at zevion.bond/docs instead.
NEXT_PUBLIC_DOCS_URL=
# Where the verification page lives (auth.zevion.bond). Needs the two Turnstile values below.
NEXT_PUBLIC_AUTH_URL=https://auth.zevion.bond
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Links ──
NEXT_PUBLIC_SUPPORT_URL=https://discord.gg/75WUGBKbd5
# Optional: your own invite link. Otherwise /invite is built from DISCORD_CLIENT_ID.
NEXT_PUBLIC_INVITE_URL=
# Bot permissions number used by /invite (8 = Administrator).
INVITE_PERMISSIONS=8
# Shown in the footer and legal pages. Razorpay asks for a contact email on your website.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: a Discord webhook that also posts each website ticket in a private channel. Tickets are saved either way.
SUPPORT_WEBHOOK_URL=
# Discord user IDs (comma separated, no spaces) who can read website tickets in the dashboard. Admins in NEXT_PUBLIC_ADMIN_IDS can too.
SUPPORT_USER_IDS=

# ── Razorpay (Premium payments) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
